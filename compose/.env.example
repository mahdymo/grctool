# Copy to .env and fill in. NEVER commit the real .env (gitignored).
# Dev values may be anything; prod values come from the secrets manager (spec §6.1.2).

# Postgres superuser (container bootstrap only)
POSTGRES_ADMIN_PASSWORD=change-me

# Per-service database passwords (least-privilege users, spec §6.1.6)
CISO_DB_PASSWORD=change-me
KC_DB_PASSWORD=change-me
CP_DB_PASSWORD=change-me
EW_DB_PASSWORD=change-me

# Keycloak bootstrap admin (dev only; prod uses break-glass procedure, spec §5.1)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me

# Control plane <-> instance API token (mTLS replaces this in prod, spec §6.2)
CONTROL_PLANE_TOKEN=change-me

# Resend — separate keys per environment, never committed (spec §4.4.2)
RESEND_API_KEY=re_test_placeholder
RESEND_WEBHOOK_SECRET=whsec_placeholder
EMAIL_FROM_DEFAULT=GRC Platform <notifications@grc.localhost>
