# Production environment template.
# On the server:  cp env.production.example .env  and fill in every value.
# NEVER commit the real .env. Generate passwords with: openssl rand -base64 24

# ---- Hostnames (this deployment: ia.tareeq.one) ----
# Layout: apex = app, subdomains for the other services.
# DNS A/AAAA records for ALL four names must point at this server.
APP_HOST=ia.tareeq.one
AUTH_HOST=auth.ia.tareeq.one
OPS_HOST=ops.ia.tareeq.one
HOOKS_HOST=hooks.ia.tareeq.one
APP_SCHEME=https
# Let's Encrypt account email (expiry notices)
ACME_EMAIL=ops@tareeq.one

# ---- Listening ports on the host ----
# If other containers already occupy 80/443, pick free ports here — but note
# Let's Encrypt HTTP/TLS challenges need 80 or 443 reachable from the internet.
# Options when they're taken: free 80/443 for this stack, put this stack
# behind your existing reverse proxy, or use a DNS-01 challenge (see
# docs/deployment.md).
HTTP_PORT=80
HTTPS_PORT=443
# Local port for the email-worker webhook receiver (bound to 127.0.0.1;
# unused in prod where webhooks arrive via Caddy on HOOKS_HOST)
WEBHOOK_PORT=8081

# ---- Secrets (all required, all unique) ----
POSTGRES_ADMIN_PASSWORD=
CISO_DB_PASSWORD=
KC_DB_PASSWORD=
CP_DB_PASSWORD=
EW_DB_PASSWORD=
KC_ADMIN_USER=kc-admin
KC_ADMIN_PASSWORD=
CONTROL_PLANE_TOKEN=

# Resend — prod key + webhook signing secret (spec §4.4.2)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_DEFAULT=GRC Platform <notifications@ia.tareeq.one>
