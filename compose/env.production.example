# Production environment template.
# On the server:  cp env.production.example .env  and fill in every value.
# NEVER commit the real .env. Generate passwords with: openssl rand -base64 24

# ---- Hostnames (this deployment: ia.tareeq.one) ----
# Layout: apex = app, subdomains for the other services.
# ALL FOUR MUST BE DISTINCT — duplicate names make Caddy fail with
# "ambiguous site definition". A wildcard DNS record (*.ia.tareeq.one)
# covers the three subdomains with one entry.
APP_HOST=ia.tareeq.one
AUTH_HOST=auth.ia.tareeq.one
OPS_HOST=ops.ia.tareeq.one
HOOKS_HOST=hooks.ia.tareeq.one
APP_SCHEME=https
# Let's Encrypt account email (expiry notices)
ACME_EMAIL=ops@tareeq.one

# ---- Listening ports on the host ----
# If other containers already occupy 80/443, pick free ports here.
# HTTPS_PORT: external + internal TLS port. If you change it from 443 you
# MUST also set APP_PORT_SUFFIX below to the same port, e.g. ":9443", and
# browse to https://ia.tareeq.one:9443.
# Let's Encrypt's HTTP-01 challenge needs HTTP_PORT=80 reachable from the
# internet regardless of HTTPS_PORT — see docs/deployment.md if 80 is taken.
HTTP_PORT=80
HTTPS_PORT=9443
# Public-URL port suffix: empty when HTTPS_PORT=443, otherwise ":<port>"
APP_PORT_SUFFIX=:9443
# Local port for the email-worker webhook receiver (bound to 127.0.0.1;
# unused in prod where webhooks arrive via Caddy on HOOKS_HOST)
WEBHOOK_PORT=8081

# ---- Secrets (all required, all unique) ----
POSTGRES_ADMIN_PASSWORD=
CISO_DB_PASSWORD=
KC_DB_PASSWORD=
CP_DB_PASSWORD=
EW_DB_PASSWORD=
KC_ADMIN_USER=kc-admin
KC_ADMIN_PASSWORD=
CONTROL_PLANE_TOKEN=

# Resend — prod key + webhook signing secret (spec §4.4.2)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_DEFAULT=GRC Platform <notifications@ia.tareeq.one>
