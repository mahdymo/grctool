# Dev reverse proxy. Host-based routing per spec §2.1:
#   app.grc.localhost        -> customer1 CISO Assistant instance
#   auth.grc.localhost       -> Keycloak
#   ops.grc.localhost        -> control plane (our team only)
#   partner-a.grc.localhost  -> customer instance with partner-A theme (Phase 2)
# *.localhost resolves to 127.0.0.1 on Windows/macOS/most Linux.

{
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1
	}
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}

app.grc.localhost:80 {
	import security_headers
	reverse_proxy /api/* backend:8000
	reverse_proxy /* frontend:3000
}

auth.grc.localhost:80 {
	import security_headers
	reverse_proxy keycloak:8080
}

ops.grc.localhost:80 {
	import security_headers
	reverse_proxy control-plane:8000
}

