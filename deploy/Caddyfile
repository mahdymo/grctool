# HTTP-only reverse proxy — no TLS. Used for local dev AND for deployments
# without certificates (set CADDYFILE=../deploy/Caddyfile in .env).
# Hostnames and port come from env; defaults = *.grc.localhost on :80.
#   {$APP_HOST}   -> customer1 CISO Assistant instance
#   {$AUTH_HOST}  -> Keycloak
#   {$OPS_HOST}   -> control plane (our team only)
#   {$HOOKS_HOST} -> email worker webhooks
# Phase 2 adds partner vhosts here (theme + per-partner realm).

http://{$APP_HOST:app.grc.localhost}:{$HTTP_PORT:80} {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	reverse_proxy /api/* backend:8000
	reverse_proxy /* frontend:3000
}

http://{$AUTH_HOST:auth.grc.localhost}:{$HTTP_PORT:80} {
	header {
		-Server
		X-Content-Type-Options nosniff
	}
	reverse_proxy keycloak:8080
}

http://{$OPS_HOST:ops.grc.localhost}:{$HTTP_PORT:80} {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
	reverse_proxy control-plane:8000
}

http://{$HOOKS_HOST:hooks.grc.localhost}:{$HTTP_PORT:80} {
	header {
		-Server
		X-Content-Type-Options nosniff
	}
	reverse_proxy email-worker:8081
}
