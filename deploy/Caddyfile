# Dev reverse proxy — HTTP only, hostnames from env (defaults = *.grc.localhost).
# Prod uses deploy/Caddyfile.prod (automatic HTTPS). Host layout:
#   {$APP_HOST}   -> customer1 CISO Assistant instance
#   {$AUTH_HOST}  -> Keycloak
#   {$OPS_HOST}   -> control plane (our team only)
# Phase 2 adds partner vhosts here (theme + per-partner realm).

http://{$APP_HOST:app.grc.localhost} {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	reverse_proxy /api/* backend:8000
	reverse_proxy /* frontend:3000
}

http://{$AUTH_HOST:auth.grc.localhost} {
	header {
		-Server
		X-Content-Type-Options nosniff
	}
	reverse_proxy keycloak:8080
}

http://{$OPS_HOST:ops.grc.localhost} {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
	reverse_proxy control-plane:8000
}
